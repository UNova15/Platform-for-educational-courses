<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.0.3</version>
        <relativePath/>
    </parent>

    <groupId>org.platform</groupId>
    <artifactId>Platform-for-educational-courses</artifactId>
    <version>0.0.1</version>
    <packaging>pom</packaging>
    <name>Platform-for-educational-courses</name>
    <description>Platform-for-educational-courses</description>

    <modules>
        <module>common</module>
        <module>auth</module>
        <module>course</module>
        <module>progress</module>
        <module>application</module>
        <module>infrastructure</module>
    </modules>
    <scm>
        <connection/>
        <developerConnection/>
        <tag/>
        <url/>
    </scm>

    <properties>
        <java.version>25</java.version>
        <maven.version>3.9.12</maven.version>

        <modernizer.version>3.2.0</modernizer.version>
        <spotbugs.version>4.9.8</spotbugs.version>
        <maven-pmd-plugin.version>3.28.0</maven-pmd-plugin.version>
        <modernizer-maven-plugin.version>${modernizer.version}</modernizer-maven-plugin.version>
        <pmd.version>7.21.0</pmd.version>
        <palantir-java-format.version>2.86.0</palantir-java-format.version>
        <spotbugs-findsecbugs-plugin.version>1.14.0</spotbugs-findsecbugs-plugin.version>
        <spotbugs-maven-plugin.version>${spotbugs.version}.2</spotbugs-maven-plugin.version>
        <spotbugs-slf4j-plugin.version>1.5.0</spotbugs-slf4j-plugin.version>
        <spotless-maven-plugin.version>3.2.1</spotless-maven-plugin.version>

        <org.springdoc.version>3.0.3</org.springdoc.version>
        <org.postgresql.version>42.7.10</org.postgresql.version>
        <org.junit.jupiter.version>5.10.2</org.junit.jupiter.version>
        <org.mockito.version>5.11.0</org.mockito.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!--Внутренние экспортируемые модули проекта-->
            <dependency>
                <groupId>org.platform</groupId>
                <artifactId>common</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.platform</groupId>
                <artifactId>auth-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.platform</groupId>
                <artifactId>progress-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.platform</groupId>
                <artifactId>course-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>org.platform</groupId>
                <artifactId>infrastructure-api</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Тестирование -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit-jupiter.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-junit-jupiter</artifactId>
                <version>${org.mockito.version}</version>
                <scope>test</scope>
            </dependency>

        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>application</finalName>
        <plugins>
            <plugin>
                <groupId>org.gaul</groupId>
                <artifactId>modernizer-maven-plugin</artifactId>
                <version>${modernizer-maven-plugin.version}</version>
                <configuration>
                    <javaVersion>${java.version}</javaVersion>
                </configuration>
            </plugin>
            <plugin>
                <groupId>com.github.spotbugs</groupId>
                <artifactId>spotbugs-maven-plugin</artifactId>
                <version>${spotbugs-maven-plugin.version}</version>
                <configuration>
                    <excludeFilterFile>spotbugs-excludes.xml</excludeFilterFile>
                    <effort>Max</effort>
                    <htmlOutput>true</htmlOutput>
                    <xmlOutput>true</xmlOutput>
                    <outputDirectory>${project.reporting.outputDirectory}/spotbugs</outputDirectory>
                    <spotbugsXmlOutputDirectory>${project.reporting.outputDirectory}/spotbugs
                    </spotbugsXmlOutputDirectory>
                    <plugins>
                        <plugin>
                            <groupId>com.h3xstream.findsecbugs</groupId>
                            <artifactId>findsecbugs-plugin</artifactId>
                            <version>${spotbugs-findsecbugs-plugin.version}</version>
                        </plugin>
                        <plugin>
                            <groupId>jp.skypencil.findbugs.slf4j</groupId>
                            <artifactId>bug-pattern</artifactId>
                            <version>${spotbugs-slf4j-plugin.version}</version>
                        </plugin>
                    </plugins>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-pmd-plugin</artifactId>
                <version>${maven-pmd-plugin.version}</version>
                <configuration>
                    <targetJdk>${java.version}</targetJdk>
                    <printFailingErrors>true</printFailingErrors>
                    <linkXRef>false</linkXRef>
                    <outputDirectory>${project.reporting.outputDirectory}/pmd</outputDirectory>
                    <rulesets>
                        <ruleset>pmd.xml</ruleset>
                    </rulesets>
                </configuration>
                <dependencies>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-core</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                    <dependency>
                        <groupId>net.sourceforge.pmd</groupId>
                        <artifactId>pmd-java</artifactId>
                        <version>${pmd.version}</version>
                    </dependency>
                </dependencies>
            </plugin>
            <plugin>
                <groupId>com.diffplug.spotless</groupId>
                <artifactId>spotless-maven-plugin</artifactId>
                <version>${spotless-maven-plugin.version}</version>
                <configuration>
                    <java>
                        <palantirJavaFormat>
                            <version>${palantir-java-format.version}</version>
                            <style>PALANTIR</style>
                        </palantirJavaFormat>
                    </java>
                    <pom>
                        <sortPom>
                            <expandEmptyElements>false</expandEmptyElements>
                            <nrOfIndentSpace>4</nrOfIndentSpace>
                            <predefinedSortOrder>recommended_2008_06</predefinedSortOrder>
                            <sortDependencies>none</sortDependencies>
                            <sortDependencyExclusions>none</sortDependencyExclusions>
                            <sortDependencyManagement>none</sortDependencyManagement>
                            <sortExecutions>false</sortExecutions>
                            <sortModules>true</sortModules>
                            <sortPlugins>none</sortPlugins>
                            <sortProperties>false</sortProperties>
                        </sortPom>
                    </pom>
                    <markdown>
                        <includes>
                            <include>*.md</include>
                        </includes>
                        <flexmark/>
                    </markdown>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
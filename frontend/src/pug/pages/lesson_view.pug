doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="css/main.css")
        title Урок | Platform
    body
        include ../blocks/header

        main.lesson-view-page
            .lesson-view-container
                a.lesson-view__back(href="javascript:history.back()") ← Назад
                h1.lesson-view__title#lessonTitle Загрузка...
                .lesson-view__content#lessonContent
                .lesson-view__loading#lessonLoading Загрузка...
                .lesson-view__error#lessonError(hidden) Не удалось загрузить урок

        script(type="module" src="js/main.min.js")
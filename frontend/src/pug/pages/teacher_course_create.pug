doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="css/main.css")
        title Создание курса | Platform
    body
        include ../blocks/header

        main.course-create-page
            .course-create-container

                nav.breadcrumbs
                    a.breadcrumbs__link(href="teacher_index.html") Главная
                    span.breadcrumbs__separator /
                    span.breadcrumbs__current создание курса

                form.course-form#courseForm

                    .course-form__field
                        input.course-form__title-input#courseTitle(
                            type="text"
                            placeholder="Введите название курса"
                            maxlength="100"
                            required
                        )


                    .course-form__field
                        input.course-form__desc-input#courseDescription(
                            type="text"
                            placeholder="Описание курса"
                            maxlength="500"
                        )

                    .course-form__field
                        select.course-form__select#courseTag
                            option(value="" disabled selected) Выберите категорию
                            option(value="PROGRAMMING_AND_IT") Программирование и IT
                            option(value="MATHEMATICS_AND_EXACT_SCIENCES") Математика и точные науки
                            option(value="BUSINESS_AND_CAREER") Бизнес и карьера
                            option(value="DESIGN_AND_CREATIVITY") Дизайн и творчество
                            option(value="LANGUAGES_AND_HUMANITIES") Языки и гуманитарные науки
                            option(value="PERSONAL_GROWTH_AND_HOBBIES") Личностный рост и хобби


                    .course-form__modules#modulesContainer


                    .course-form__actions-bottom
                        button.btn-add.btn-add--module(type="button" id="addModuleBtn")
                            span.btn-add__icon +
                            | Добавить модуль

                    .course-form__submit
                        button.btn-submit(type="submit") Добавить курс

        script(type="module" src="js/main.min.js")
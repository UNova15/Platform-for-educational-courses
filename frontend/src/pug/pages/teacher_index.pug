doctype html
html(lang="ru")
    head
        meta(charset="UTF-8")
        meta(name="viewport" content="width=device-width, initial-scale=1.0")
        link(rel="stylesheet", href="css/main.css")
        title Мои курсы | Platform
    body
        include ../blocks/header

        main.teacher-page
            .teacher-container

                h1.teacher-page__title Мои курсы

                .teacher-subheader
                    h2.teacher-subheader__title Мои курсы
                    a.teacher-subheader__add-btn(href="/teacher_course_create.html") Создать курс

                .teacher-courses-grid#teacherCoursesGrid


                .teacher-courses-grid#teacherCoursesSkeleton
                    .teacher-course-card.teacher-course-card--skeleton
                    .teacher-course-card.teacher-course-card--skeleton
                    .teacher-course-card.teacher-course-card--skeleton
                    .teacher-course-card.teacher-course-card--skeleton


                .teacher-empty#teacherEmpty(hidden)
                    p.teacher-empty__text У вас пока нет курсов
                    a.teacher-empty__btn(href="/teacher_course_create.html") Создать первый курс

        script(type="module" src="js/main.min.js")
header.header
    .header-container
        a.logo(href="/index.html")
            img.logo__img(src="/assets/ipeg/logo2.jpg" alt="Логотип Platform")

        .header-right
            .search-wrapper
                form.search-form(action="/search" method="GET")
                    input.search-input(
                        type="text"
                        name="query"
                        placeholder=""
                    )
                    button.search-btn(type="submit" aria-label="Поиск")
                        svg(width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="11" cy="11" r="8")
                            line(x1="21" y1="21" x2="16.65" y2="16.65")

            .header-divider

            a.btn__profile-btn#profileBtn(href="#" type="button")
                svg.profile-icon(width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    path(d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2")
                    circle(cx="12" cy="7" r="4")
                span Профиль